{
  "name": "identity-wallet-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 47831",
    "build": "next build",
    "start": "next start --hostname localhost --port 47831",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check:env": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-env.ts",
    "check": "npm run check:env && npm run lint && npm run test && npm run typecheck && npm run build && npm run check:artifact",
    "dev:container": "next dev --hostname 0.0.0.0 --port 47831",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "lint": "eslint . --max-warnings=0",
    "walt:setup": "node --experimental-strip-types scripts/setup-walt.ts",
    "walt:up": "docker compose up -d issuer wallet verifier",
    "proof:integration": "node --experimental-strip-types scripts/prove-integration.ts",
    "test:f1": "node --env-file=.env.local --experimental-strip-types scripts/check-f1.ts",
    "test:e2e": "playwright test",
    "check:artifact": "node --experimental-strip-types scripts/check-artifact.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
