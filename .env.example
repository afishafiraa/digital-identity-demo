# Copy to .env.local; keep it private. Restart after changes.
APP_ORIGIN=http://localhost:47831
DEMO_DATA_DIR=.local
SESSION_TTL_SECONDS=86400
MAX_ACTIVE_SESSIONS=100
# Host-app development. The container app uses internal Docker names instead.
WALT_ISSUER_URL=http://127.0.0.1:7005
WALT_WALLET_URL=http://127.0.0.1:7006
WALT_VERIFIER_URL=http://127.0.0.1:7004
# Optional server-only tokens for an authenticated service configuration.
# WALT_ISSUER_TOKEN=
# WALT_WALLET_TOKEN=
# WALT_VERIFIER_TOKEN=
